<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.github.kwp6zgnrsh.boardkitapi.member.mapper.MemberMapper">

    <select id="selectByLoginId"
            resultType="io.github.kwp6zgnrsh.boardkitapi.member.model.Member">
        SELECT
            id,
            login_id,
            password_hash,
            display_name,
            role,
            created_at,
            updated_at,
            deleted_at
        FROM member
        WHERE login_id = #{loginId}
            AND deleted_at IS NULL
    </select>

</mapper>